// Gujarat Quiz backend.
//
// Flows:
//   1. Login: school/college CTS or ABC → OTP → JWT
//      citizen: mobile → OTP → name/district/taluka → JWT
//   2. Bank play: start session (allocate unseen ACCEPTED bank Qs) -> submit -> stats
//   3. Admin: bilingual bank review (separate /api/v1/admin)
//
// Run `npm run prisma:migrate` then `npm run prisma:seed` to stand this up locally.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Mirrors ROLE in gujarat-gov-quiz/lib/domain/roles.js
enum UserRole {
  student
  college
  citizen
}

// Mirrors QUESTION_TYPE in gujarat-gov-quiz/config/question-types.js
// Legacy play/session enum (snapshot + older bank rows).
enum QuestionType {
  single_choice
  true_false
  match_following
  image_choice
  drag_drop
  drag_into_blanks
}

/// Canonical bank types for question_variants (5 product types).
enum BankQuestionType {
  mcq
  true_false
  fill_blanks
  sequence
  match_pairs
}

/// A login identity. School and college rows are provisioned (seeded / imported)
/// and resolved by CTS Number / ABC code. Citizen rows are created after OTP
/// when the user submits name, district and taluka.
model User {
  id              String    @id @default(cuid())
  role            UserRole
  name            String
  surname         String?   @db.VarChar(128)
  gender          String?   @db.VarChar(16)
  fatherName      String?   @map("father_name") @db.VarChar(128)
  motherName      String?   @map("mother_name") @db.VarChar(128)
  institute       String?
  schoolId        String?   @map("school_id") @db.VarChar(32)
  grade           String?
  districtId      Int?      @map("district_id")
  talukaId        Int?      @map("taluka_id")
  village         String?   @db.VarChar(128)
  profilePhoto    String?   @map("profile_photo") @db.VarChar(512)
  socialCategory  String?   @map("social_category") @db.VarChar(32)
  dateOfBirth     String?   @map("date_of_birth") @db.VarChar(32)
  /// AES-GCM ciphertext (or legacy plaintext digits during migration).
  mobile          String?   @db.VarChar(512)
  mobileHash      String?   @unique @map("mobile_hash") @db.VarChar(64)
  ctsId           String?   @unique @map("cts_id") @db.VarChar(32)
  apparId         String?   @unique @map("appar_id") @db.VarChar(32)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)
  taluka   Taluka?   @relation(fields: [talukaId], references: [id], onDelete: SetNull)

  quizSessions QuizSession[]
  questionExposures UserQuestionExposure[]
  analyticsVisitors AnalyticsVisitor[]
  leaderboardAggregates LeaderboardAggregate[]
  consents UserConsent[]

  @@index([schoolId])
  @@index([districtId])
  @@index([talukaId])
  @@index([institute])
  @@index([mobileHash])
  @@index([role, mobileHash])
  @@map("users")
}

model UserConsent {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id")
  consentVersion String   @map("consent_version") @db.VarChar(32)
  acceptedAt     DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([acceptedAt])
  @@map("user_consents")
}

enum AnalyticsEventType {
  certificate_download
  g3q_ai_query
  practice_quiz_start
  practice_quiz_complete
}

/// Anonymous/session visitor. Link user_id when they log in.
model AnalyticsVisitor {
  id          Int      @id @default(autoincrement())
  visitorKey  String   @unique @map("visitor_key") @db.VarChar(24)
  userId      String?  @map("user_id")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user   User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  events AnalyticsEvent[]

  @@index([userId])
  @@index([lastSeenAt])
  @@map("analytics_visitors")
}

/// Product telemetry row. Identity is always via visitor FK (user lives on visitors).
model AnalyticsEvent {
  id         BigInt             @id @default(autoincrement())
  eventType  AnalyticsEventType @map("event_type")
  occurredAt DateTime           @default(now()) @map("occurred_at")
  week       Int
  visitorId  Int                @map("visitor_id")
  /// AI-focused payload only (e.g. model, queryCount). Avoid noise like source=database.
  metadata   Json?
  createdAt  DateTime           @default(now()) @map("created_at")

  visitor AnalyticsVisitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([occurredAt])
  @@index([eventType, occurredAt])
  @@index([week])
  @@index([visitorId])
  @@map("analytics_events")
}

model LeaderboardAggregate {
  id                BigInt   @id @default(autoincrement())
  week              Int
  role              UserRole
  talukaId          Int      @map("taluka_id")
  districtId        Int?     @map("district_id")
  userId            String   @map("user_id")
  bestPercentage    Int      @default(0) @map("best_percentage")
  totalCorrect      Int      @default(0) @map("total_correct")
  totalWrong        Int      @default(0) @map("total_wrong")
  totalTimeMs       Int      @default(0) @map("total_time_ms")
  sessionsCompleted Int      @default(0) @map("sessions_completed")
  lastCompletedAt   DateTime? @map("last_completed_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taluka   Taluka   @relation(fields: [talukaId], references: [id], onDelete: Cascade)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@unique([week, role, talukaId, userId])
  @@index([week, talukaId, role])
  @@index([week, role, talukaId, bestPercentage, totalCorrect, totalTimeMs], map: "leaderboard_aggregates_rank_idx")
  @@index([userId, week])
  @@map("leaderboard_aggregates")
}

model LeaderboardTalukaStat {
  id                BigInt   @id @default(autoincrement())
  week              Int
  talukaId          Int      @map("taluka_id")
  districtId        Int?     @map("district_id")
  submittedSessions Int      @default(0) @map("submitted_sessions")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  taluka   Taluka    @relation(fields: [talukaId], references: [id], onDelete: Cascade)
  district District? @relation(fields: [districtId], references: [id], onDelete: SetNull)

  @@unique([week, talukaId])
  @@index([week, submittedSessions])
  @@map("leaderboard_taluka_stats")
}

model District {
  id        Int      @id
  nameEn    String   @unique @map("name_en") @db.VarChar(128)
  nameGu    String   @unique @map("name_gu") @db.VarChar(128)
  nameHi    String?  @unique @map("name_hi") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  talukas               Taluka[]
  users                 User[]
  questionRoots         QuestionRoot[]
  leaderboardAggregates LeaderboardAggregate[]
  leaderboardTalukaStats LeaderboardTalukaStat[]

  @@map("districts")
}

enum TalukaType {
  taluka
  municipal_corporation
}

model Taluka {
  id         Int        @id @default(autoincrement())
  districtId Int        @map("district_id")
  nameEn     String     @map("name_en") @db.VarChar(128)
  nameGu     String     @map("name_gu") @db.VarChar(128)
  nameHi     String     @map("name_hi") @db.VarChar(128)
  type       TalukaType @default(taluka)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  district               District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  users                  User[]
  leaderboardAggregates  LeaderboardAggregate[]
  leaderboardTalukaStats LeaderboardTalukaStat[]

  @@unique([districtId, nameEn])
  @@unique([districtId, nameGu])
  @@index([districtId])
  @@index([type])
  @@map("talukas")
}

model Department {
  id        Int      @id
  key       String   @unique @db.VarChar(64)
  nameEn    String   @unique @map("name_en") @db.VarChar(128)
  nameGu    String   @unique @map("name_gu") @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  questionRoots QuestionRoot[]
  quizImages    DepartmentQuizImage[]

  @@map("departments")
}

model DepartmentQuizImage {
  id           BigInt     @id @default(autoincrement())
  departmentId Int        @map("department_id")
  style        String     @db.VarChar(32)
  imageUrl     String     @map("image_url") @db.VarChar(512)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([departmentId, style, imageUrl])
  @@index([departmentId, style, isActive])
  @@map("department_quiz_images")
}

/// Bank-backed play session: N questions allocated once at start, then graded on submit.
enum SessionStatus {
  in_progress
  submitted
  abandoned
  expired
}

model QuizSession {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  status         SessionStatus @default(in_progress)
  questionCount  Int           @map("question_count")
  language       String        @default("gu") @db.VarChar(8)
  startedAt      DateTime      @map("started_at")
  expiresAt      DateTime?     @map("expires_at")
  completedAt    DateTime?     @map("completed_at")
  correctCount   Int?          @map("correct_count")
  wrongCount     Int?          @map("wrong_count")
  totalTimeMs    Int?          @map("total_time_ms")
  percentage     Int?
  createdAt      DateTime      @default(now()) @map("created_at")

  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions QuizSessionQuestion[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, status, completedAt])
  @@index([status, completedAt, userId])
  @@map("quiz_sessions")
}

/// Frozen snapshot of a variant inside a session.
/// Correct answers stay server-side until lock/reveal or final result.
model QuizSessionQuestion {
  id            String  @id @default(cuid())
  sessionId     String  @map("session_id")
  order         Int
  type          QuestionType @default(single_choice)
  /// Public id (= variant.legacy_que_id) for client answer maps.
  queId         String  @map("que_id") @db.VarChar(32)
  variantId     Int     @map("variant_id")
  points        Int     @default(1)
  departmentGu  String? @map("department_gu") @db.VarChar(255)
  departmentEn  String? @map("department_en") @db.VarChar(255)
  questionGu    String? @map("question_gu") @db.Text
  questionEn    String? @map("question_en") @db.Text
  optionAGu     String? @map("option_a_gu") @db.Text
  optionBGu     String? @map("option_b_gu") @db.Text
  optionCGu     String? @map("option_c_gu") @db.Text
  optionDGu     String? @map("option_d_gu") @db.Text
  optionAEn     String? @map("option_a_en") @db.Text
  optionBEn     String? @map("option_b_en") @db.Text
  optionCEn     String? @map("option_c_en") @db.Text
  optionDEn     String? @map("option_d_en") @db.Text
  correctOption String  @map("correct_option") @db.Char(1)
  content       Json?
  answer        Json?
  selectedOption String? @map("selected_option") @db.Char(1)
  selectedAnswer Json?   @map("selected_answer")
  isCorrect     Boolean? @map("is_correct")
  timeSpentMs   Int?     @map("time_spent_ms")

  session QuizSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  variant QuestionVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([sessionId, order])
  @@unique([sessionId, variantId])
  @@index([variantId])
  @@index([queId])
  @@map("quiz_session_questions")
}

/// Per-user history of variants seen — drives no-repeat allocation.
model UserQuestionExposure {
  userId       String   @map("user_id")
  variantId    Int      @map("variant_id")
  rootId       Int      @map("root_id")
  firstSeenAt  DateTime @map("first_seen_at")
  lastSeenAt   DateTime @map("last_seen_at")
  timesSeen    Int      @default(1) @map("times_seen")
  timesCorrect Int      @default(0) @map("times_correct")
  timesWrong   Int      @default(0) @map("times_wrong")
  totalTimeMs  Int      @default(0) @map("total_time_ms")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant QuestionVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  root    QuestionRoot    @relation(fields: [rootId], references: [id], onDelete: Cascade)

  @@id([userId, variantId])
  @@index([userId, lastSeenAt])
  @@index([userId, rootId])
  @@index([rootId])
  @@map("user_question_exposures")
}

/// One OTP challenge for a login attempt. created_at = requested; expires_at ≈ +10m;
/// verified_at = OTP accepted. No user_id (signup often has no user yet).
model OtpRequest {
  id             Int       @id @default(autoincrement())
  /// Opaque public handle returned as otp_token (never expose numeric id).
  token          String    @unique @db.VarChar(32)
  role           UserRole
  mobile         String    @db.VarChar(20)
  otp            String    @db.VarChar(16)
  expiresAt      DateTime  @map("expires_at")
  verifiedAt     DateTime? @map("verified_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([mobile, createdAt])
  @@index([mobile, lockedUntil])
  @@map("otp_requests")
}

// ---------------------------------------------------------------------------
// Admin console + bilingual MCQ bank (formerly admin/ FastAPI MySQL schema).
// ---------------------------------------------------------------------------

enum AdminRole {
  master
  sub_admin
  admin
}

enum ReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Console operator — username/password login (not student OTP users).
model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.VarChar(64)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         AdminRole @default(admin)
  accessScope  String?  @map("access_scope") @db.VarChar(32)
  fullName     String?  @map("full_name") @db.VarChar(128)
  university   String?  @db.VarChar(255)
  mobileNumber String?  @map("mobile_number") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  reviewedVariants  QuestionVariant[] @relation("VariantReviewedBy")
  editedVariants    QuestionVariant[] @relation("VariantEditedBy")
  editedRoots       QuestionRoot[] @relation("RootEditedBy")
  comments          QuestionVariantComment[]
  activities        QuestionVariantActivity[]
  workQuota         AdminWorkQuota?
  quotasCreated     AdminWorkQuota[] @relation("QuotaSetter")
  assignedWork      AdminQuestionAssignment[] @relation("AssignedAdmin")
  assignmentsMade   AdminQuestionAssignment[] @relation("AssignmentCreator")

  @@map("admin_users")
}

/// One concept + shared explanation. Scope / district / caste live here (serve filters).
model QuestionRoot {
  id               Int      @id @default(autoincrement())
  /// Preserves legacy bank que_id for 1:1 migrated roots (nullable for new multi-variant roots).
  legacyQueId      String?  @unique @map("legacy_que_id") @db.VarChar(32)
  departmentId     Int?     @map("department_id")
  scope            String   @default("GENERAL") @db.VarChar(32)
  districtId       Int?     @map("district_id")
  casteCategory    String   @default("GENERAL") @map("caste_category") @db.VarChar(32)
  explanationGu    String?  @map("explanation_gu") @db.Text
  explanationEn    String?  @map("explanation_en") @db.Text
  explanationHi    String?  @map("explanation_hi") @db.Text
  lastEditedById   Int?     @map("last_edited_by_id")
  lastEditedAt     DateTime? @map("last_edited_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  departmentRef     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  districtRef       District?       @relation(fields: [districtId], references: [id], onDelete: SetNull)
  lastEditedBy      AdminUser?      @relation("RootEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  variants          QuestionVariant[]
  exposures         UserQuestionExposure[]

  @@index([scope])
  @@index([districtId])
  @@index([casteCategory])
  @@index([scope, districtId, casteCategory])
  @@index([departmentId])
  @@map("question_roots")
}

/// One type-version of a root. Multilingual type-specific body is in `payload` JSON.
model QuestionVariant {
  id             Int              @id @default(autoincrement())
  rootId         Int              @map("root_id")
  type           BankQuestionType
  /// Public API id (legacy bank que_id for migrated rows).
  legacyQueId    String           @unique @map("legacy_que_id") @db.VarChar(32)
  payload        Json
  reviewStatus   ReviewStatus     @default(PENDING) @map("review_status")
  reviewedById   Int?             @map("reviewed_by_id")
  reviewedAt     DateTime?        @map("reviewed_at")
  lastEditedById Int?             @map("last_edited_by_id")
  lastEditedAt   DateTime?        @map("last_edited_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  root         QuestionRoot @relation(fields: [rootId], references: [id], onDelete: Cascade)
  reviewedBy   AdminUser?   @relation("VariantReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  lastEditedBy AdminUser?   @relation("VariantEditedBy", fields: [lastEditedById], references: [id], onDelete: SetNull)
  comments     QuestionVariantComment[]
  activities   QuestionVariantActivity[]
  sessionQuestions QuizSessionQuestion[]
  exposures    UserQuestionExposure[]
  assignment   AdminQuestionAssignment?

  @@unique([rootId, type])
  @@index([type])
  @@index([reviewStatus])
  @@index([reviewStatus, type])
  @@index([rootId, reviewStatus])
  @@map("question_variants")
}

model QuestionVariantComment {
  id        Int      @id @default(autoincrement())
  variantId Int      @map("variant_id")
  userId    Int      @map("user_id")
  username  String   @db.VarChar(64)
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  admin   AdminUser       @relation(fields: [userId], references: [id])
  variant QuestionVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("question_variant_comments")
}

model QuestionVariantActivity {
  id        Int      @id @default(autoincrement())
  variantId Int      @map("variant_id")
  userId    Int      @map("user_id")
  username  String   @db.VarChar(64)
  action    String   @db.VarChar(32)
  detail    String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  admin   AdminUser       @relation(fields: [userId], references: [id])
  variant QuestionVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
  @@map("question_variant_activities")
}

/// Optional standing review target for a sub-admin (not used for day-wise queues).
model AdminWorkQuota {
  id          Int      @id @default(autoincrement())
  adminId     Int      @unique @map("admin_id")
  dailyQuota  Int      @map("daily_quota")
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?  @db.VarChar(500)
  createdById Int      @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdBy AdminUser @relation("QuotaSetter", fields: [createdById], references: [id])

  @@map("admin_work_quotas")
}

/// One variant reserved for one reviewer. Unique on variant_id so two
/// sub-admins never share the same pending row. assignment_date is a stamp only.
model AdminQuestionAssignment {
  id             Int      @id @default(autoincrement())
  adminId        Int      @map("admin_id")
  variantId      Int      @map("variant_id")
  assignmentDate DateTime @map("assignment_date") @db.Date
  assignedById   Int      @map("assigned_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  admin      AdminUser       @relation("AssignedAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  assignedBy AdminUser       @relation("AssignmentCreator", fields: [assignedById], references: [id])
  variant    QuestionVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId])
  @@index([adminId, assignmentDate])
  @@index([assignmentDate])
  @@map("admin_question_assignments")
}
