NODE_ENV="DEVELOPMENT" # DEVELOPMENT, PRODUCTION
# App database (new). Keep legacy `g3q` separate and copy into this DB.
DATABASE_URL=mysql://g3q:g3q_local_pass@127.0.0.1:3307/g3q_backend
PORT=4000
# Production App Service: set WEB_CONCURRENCY=4 so each instance uses all P2v3 vCPUs.
# Local/dev: leave unset or WEB_CONCURRENCY=1 (nodemon uses single process via npm run dev).
# WEB_CONCURRENCY=1

# Legacy bank MySQL (read-only source for `npm run import:legacy-bank`)
LEGACY_MYSQL_HOST=127.0.0.1
LEGACY_MYSQL_PORT=3307
LEGACY_MYSQL_USER=g3q
LEGACY_MYSQL_PASSWORD=g3q_local_pass
LEGACY_MYSQL_DATABASE=g3q

JWT_SECRET=change_me
JWT_EXPIRY=30d

OTP_EXPIRY_MINUTES=5
OTP_RESEND_SECONDS=30
# Accepted in addition to the real OTP outside production, since there's no
# SMS gateway wired up yet (see src/services/auth.service.js).
OTP_LENGTH=4
OTP_DEV_BYPASS_CODE=1234

# Single switch for beta auth (registration + POST /api/auth/beta/login).
# Mirrors client NEXT_PUBLIC_IS_BETA_TIME.
IS_BETA_TIME=false

# Student quiz client origin(s). Comma-separated FRONTEND_ORIGINS overrides/extends.
FRONTEND_DOMAIN="http://localhost:3000"
ADMIN_FRONTEND_DOMAIN="http://localhost:3001"
FRONTEND_ORIGINS="http://localhost:3000,http://localhost:3001"
# Set true on Azure to allow any frontend origin/port (with credentials).
CORS_ALLOW_ALL=false
BACKEND_BASE_URL="http://localhost:4000"

# Bootstrap master admin (created on server start / seed if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=G3Q@Admin2026
ADMIN_FULL_NAME=G3Q Administrator
ADMIN_UNIVERSITY=Gujarat Technological University
ADMIN_MOBILE_NUMBER=9999999999

# Bank-backed play sessions
QUIZ_SESSION_QUESTION_COUNT=15
QUIZ_SESSION_EXPIRY_MINUTES=90
QUIZ_DEFAULT_LANGUAGE=gu
QUIZ_CURRENT_WEEK=5
QUIZ_PERSONALIZED_MIN=4
QUIZ_PERSONALIZED_MAX=5

# Gemini configuration
# Docs: https://ai.google.dev/gemini-api/docs/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=20000

# Azure Blob Storage for G3Q assets (profile photos under Profile/)
# Use a storage ACCOUNT whose name starts with g3q (not edutors), e.g. g3qstorage.
# Public URLs become: https://{ACCOUNT}.blob.core.windows.net/g3q/Profile/...
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=g3q
# Optional: override public URL origin if you use a custom/CDN host
# AZURE_STORAGE_PUBLIC_BASE_URL=https://g3qstorage.blob.core.windows.net
