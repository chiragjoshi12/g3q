# Client → backend API
# Copy to `.env.local` for local overrides (gitignored).
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# Express origin (no trailing slash, no `/api` suffix).
# Next rewrites browser calls from `/api/*` → `${BACKEND_ORIGIN}/api/*`
#
# Local:
BACKEND_ORIGIN=http://localhost:4000
#
# Production / staging examples (use one):
# BACKEND_ORIGIN=https://g3q-backend-staging.azurewebsites.net
# BACKEND_ORIGIN=https://g3q-backend.azurewebsites.net

# Optional: call the API host directly from the browser (skips the /api rewrite).
# Leave unset to use same-origin `/api` (recommended).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# Data source: `rest` (default) or `json`
# NEXT_PUBLIC_DATA_SOURCE=rest
