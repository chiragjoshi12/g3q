# Express host for Next.js rewrites (no trailing slash, no /api).
# Local default: http://localhost:4000
# Production default: https://g3q-backend.azurewebsites.net
# Staging: set BACKEND_ORIGIN to the staging Azure App Service URL.
# BACKEND_ORIGIN=http://localhost:4000

# Browser/API base. Leave as /api to use the rewrite above.
# NEXT_PUBLIC_API_BASE_URL=/api

# Use live Express instead of bundled JSON fixtures.
# NEXT_PUBLIC_DATA_SOURCE=rest

# Certificate week label on home.
# NEXT_PUBLIC_G3Q_WEEK=5
